# Copy this file to ".env" (not ".env.example") and fill in your real key.
# NEVER commit the real .env file to GitHub.

GEMINI_API_KEY=paste_your_key_here

# Optional: change this if you want a different Gemini model.
# Check aistudio.google.com for the exact model names available on the free tier.
GEMINI_MODEL=gemini-2.0-flash

PORT=5000
